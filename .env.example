# Web3Forms API key for contact form
# Get your free key at https://web3forms.com
# Optional: without it the contact form renders in its "not configured" state
# instead of breaking the build.
PUBLIC_WEB3FORMS_KEY=your_key_here

# Optional GitHub token, read at build time only (never shipped to the browser).
# Raises the API quota from 60/h per IP to 5000/h so the projects page doesn't
# build empty under rate limiting. CI supplies the automatic secrets.GITHUB_TOKEN.
GITHUB_TOKEN=
